#!/bin/ash

detect_work_mode() {
    local has_nat=0

    # 优先读取实时运行的防火墙规则（真实生效的NAT）
    if command -v nft >/dev/null 2>&1; then
        # 尝试读取nat表，表存在并且里面有masquerade规则 → NAT生效
        if nft list table nat 2>/dev/null | grep -q masquerade; then
            has_nat=1
        fi
    elif command -v iptables >/dev/null 2>&1; then
        if iptables -t nat -nL POSTROUTING 2>/dev/null | grep -q MASQUERADE; then
            has_nat=1
        fi
    fi

    # 只根据实时运行结果判断
    if [ $has_nat -eq 1 ]; then
        echo "NAT Mode"
    else
        echo "Bypass Mode"
    fi
}


# 获取LAN DHCP(dnsmasq)服务状态
get_lan_dhcp_status() {
    local ignore
    ignore=$(uci -q get dhcp.lan.ignore 2>/dev/null)
    if [ "$ignore" = "1" ]; then
        echo "Disabled"
    else
        echo "Enabled"
    fi
}

# 检测是否开启maindhcp
is_odhcp_maindhcp() {
    local val
    val=$(uci get dhcp.odhcpd.maindhcp 2>/dev/null)
    [ "$val" = "1" ]
}

enable_lan_dhcp() {
    echo "Enabling LAN DHCP service..."
    uci -q delete dhcp.lan.ignore
    uci commit dhcp || { echo "UCI commit failed."; pause; return; }
    if is_odhcp_maindhcp; then
        /etc/init.d/odhcpd enable
        /etc/init.d/odhcpd restart || { echo "odhcpd restart failed."; pause; return; }
    else
        /etc/init.d/dnsmasq enable
        /etc/init.d/dnsmasq restart || { echo "dnsmasq restart failed."; pause; return; }
    fi
    echo "LAN DHCP service is enabled."
    pause
}

disable_lan_dhcp() {
    echo "Disabling LAN DHCP service..."
    uci set dhcp.lan.ignore='1'
    uci commit dhcp || { echo "UCI commit failed."; pause; return; }
    if is_odhcp_maindhcp; then
        /etc/init.d/odhcpd stop
        /etc/init.d/odhcpd disable
    else
        /etc/init.d/dnsmasq restart
        echo "LAN DHCP service is disabled (DNS still running)."
    fi
    pause
}

# 选项1专用，彻底停掉DHCP释放UDP67
stop_dhcp_full() {
    uci set dhcp.lan.ignore='1'
    uci commit dhcp || { echo "UCI commit failed."; pause; return; }
    if is_odhcp_maindhcp; then
        /etc/init.d/odhcpd stop
        /etc/init.d/odhcpd disable
    else
        /etc/init.d/dnsmasq stop
        /etc/init.d/dnsmasq disable
    fi
    echo "DHCP service fully stopped, UDP67 released."
    pause
}


WORK_MODE=$(detect_work_mode)
REFRESH_DELAY=1
# ANSI colors
C_RESET='\033[0m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_CYAN='\033[1;36m'
C_RED='\033[1;31m'
C_WHITE='\033[1;37m'
C_BLUE='\033[1;34m'
C_PURPLE='\033[1;35m'

pause() {
    printf "\nPress Enter to return..."
    read -r _
}

valid_ipv4() {
    echo "$1" | awk -F. '
    /^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$/ && NF==4 {
        if( ($1 >=0 && $1 <=255) && ($2 >=0 && $2 <=255) && ($3 >=0 && $3 <=255) && ($4 >=0 && $4 <=255)
            && ($1 !~ /^0[0-9]/) && ($2 !~ /^0[0-9]/) && ($3 !~ /^0[0-9]/) && ($4 !~ /^0[0-9]/) ){
            exit 0
        }
    }
    exit 1
    '
}


get_lan_proto() {
    uci -q get network.lan.proto 2>/dev/null || echo "unknown"
}

get_cpu_usage() {
    # 读取第一次采样
    read _ u1 n1 s1 idle1 iw1 irq1 sirq1 rest1 < /proc/stat
    old_total=$((u1+n1+s1+idle1+iw1+irq1+sirq1))
    old_idle=$idle1
    sleep "$REFRESH_DELAY"
    # 读取第二次采样
    read _ u2 n2 s2 idle2 iw2 irq2 sirq2 rest2 < /proc/stat
    new_total=$((u2+n2+s2+idle2+iw2+irq2+sirq2))
    new_idle=$idle2
    diff_total=$((new_total - old_total))
    diff_idle=$((new_idle - old_idle))
    if [ "$diff_total" -gt 0 ]; then
        echo $(( 100 * (diff_total - diff_idle) / diff_total ))
    else
        echo 0
    fi
}

get_memory() {
    awk '
    /^MemTotal:/ { total=$2 }
    /^MemAvailable:/ { avail=$2 }
    END {
        used = total - avail
        printf "%dMB/%dMB (%d%%)", used/1024, total/1024, used*100/total
    }' /proc/meminfo
}

get_sessions() {
    if [ -r /proc/sys/net/netfilter/nf_conntrack_count ]; then
        cat /proc/sys/net/netfilter/nf_conntrack_count
    else
        echo "N/A"
    fi
}

get_client_count() {
    {
        [ -r /tmp/dhcp.leases ] && awk '{print $3}' /tmp/dhcp.leases
        ip neigh show 2>/dev/null | awk '$1 ~ /^[0-9]+\./ && $3!="FAILED" {print $1}'
    } | sort -u | wc -l
}

get_ip_addresses() {
    ip -o -4 addr show 2>/dev/null | awk '
    $2 != "lo" {
        sub(/\/.*/,"",$4)
        printf "    ├─ %s: %s\n", $2, $4
    }'
}

draw_menu() {
    clear
    cpu="$(get_cpu_usage)"
    mem="$(get_memory)"
    sessions="$(get_sessions)"
    clients="$(get_client_count)"
    hostname="$(uci -q get system.@system[0].hostname 2>/dev/null || hostname)"
    lanproto="$(get_lan_proto)"
    lan_dhcp_status="$(get_lan_dhcp_status)"

    printf "${C_WHITE}Hostname: ${C_GREEN}%s${C_RESET}\n" "$hostname"
    printf "${C_WHITE}Cpu Usage: ${C_GREEN}%s%%${C_RESET}\n" "$cpu"
    printf "${C_WHITE}Memory Usage: ${C_GREEN}%s${C_RESET}\n" "$mem"
    printf "${C_WHITE}Network Sessions: ${C_GREEN}%s${C_RESET}\n" "$sessions"
    printf "${C_WHITE}Client Num: ${C_GREEN}%s${C_RESET}\n" "$clients"
    printf "${C_WHITE}Work Mode: ${C_GREEN}%s${C_RESET}\n" "$WORK_MODE"
    printf "${C_WHITE}LAN Protocol: ${C_GREEN}%s${C_RESET}\n" "$lanproto"
    printf "${C_WHITE}LAN DHCP Service: ${C_GREEN}%s${C_RESET}\n" "$lan_dhcp_status"
    printf "${C_WHITE}IP Addresses:${C_RESET}\n"
    get_ip_addresses

    printf "\n${C_CYAN}-------------------------------- Quick Start --------------------------------${C_RESET}\n"
    printf "${C_GREEN}[1]${C_WHITE} Set LAN(br-lan) IP Proto to DHCP and Disable LAN DHCP Service${C_RESET}\n"
    printf "${C_YELLOW}[2]${C_WHITE} Set LAN(br-lan) Static IP${C_RESET}\n"
    printf "${C_CYAN}[3]${C_WHITE} Show network interfaces (ip addr)${C_RESET}\n"
    printf "${C_BLUE}[4]${C_WHITE} Show Program Info (ps)${C_RESET}\n"
    printf "${C_PURPLE}[5]${C_WHITE} Monitor Online Clients${C_RESET}\n"
    printf "${C_GREEN}[6]${C_WHITE} Enable LAN DHCP Service${C_RESET}\n"
    printf "${C_YELLOW}[7]${C_WHITE} Disable LAN DHCP Service${C_RESET}\n"
    printf "${C_RED}[q]${C_WHITE} Enter Shell${C_RESET}\n"
    printf "${C_CYAN}-----------------------------------------------------------------------------${C_RESET}\n"
    printf "Select an option: "
}

set_lan_dhcp() {
    echo "Changing LAN protocol to DHCP and disable LAN DHCP server..."

    # 1. 修改 network 配置
    uci set network.lan.proto='dhcp' || return 1
    uci -q delete network.lan.ipaddr
    uci -q delete network.lan.netmask
    uci -q delete network.lan.gateway
    uci -q delete network.lan.broadcast
    uci commit network || { echo "network commit failed"; pause; return 1; }
    stop_dhcp_full
    echo "Config saved, restart network and dnsmasq..."
    /etc/init.d/network restart || { echo "network restart failed"; pause; return 1; }
    # /etc/init.d/dnsmasq restart || { echo "dnsmasq restart failed"; pause; return 1; }

    echo "LAN set to DHCP client, LAN DHCP server disabled."
    pause
}


set_lan_static() {
    printf "Static IPv4 address (e.g. 192.168.1.1): "
    read -r ipaddr
    if ! valid_ipv4 "$ipaddr"; then
        echo "Invalid IPv4 address."
        pause
        return
    fi
    printf "Netmask [255.255.255.0]: "
    read -r netmask
    [ -z "$netmask" ] && netmask="255.255.255.0"
    if ! valid_ipv4 "$netmask"; then
        echo "Invalid netmask."
        pause
        return
    fi
    printf "Gateway (optional, press Enter skip): "
    read -r gateway
    uci set network.lan.proto='static'
    uci set network.lan.ipaddr="$ipaddr"
    uci set network.lan.netmask="$netmask"
    if [ -n "$gateway" ]; then
        if valid_ipv4 "$gateway"; then
            uci set network.lan.gateway="$gateway"
        else
            echo "Gateway invalid, skip gateway"
        fi
    else
        uci -q delete network.lan.gateway
    fi
    uci commit network || { echo "UCI commit failed."; pause; return; }
    echo "Applying network..."
    /etc/init.d/network restart
    echo "Static IP applied: $ipaddr / $netmask"
    pause
}

show_interfaces() {
    clear
    echo "Network interfaces"
    echo "------------------"
    ip addr show 2>/dev/null
    echo
    echo "Routes:"
    ip route show 2>/dev/null
    pause
}

show_processes() {
    clear
    echo "Running processes"
    echo "-----------------"
    ps w
    pause
}

monitor_clients() {
    while :; do
        clear
        echo "Online clients (DHCP leases + ARP)"
        echo "---------------------------------"
        printf "%-18s %-18s %-24s\n" "IPv4" "MAC" "Source"
        [ -r /tmp/dhcp.leases ] && awk '{printf "%-18s %-18s DHCP Lease\n",$3,$2}' /tmp/dhcp.leases
        ip neigh show 2>/dev/null | awk '$1 ~ /^[0-9]+\./ && $3!="FAILED" {printf "%-18s %-18s ARP\n",$1,$2}'
        echo
        echo "Press q + Enter to exit monitor"
        read -r answer
        [ "$answer" = "q" ] && break
    done
    # 退出监控循环前，清空stdin残留缓冲，解决需要按两次q的BUG
    while read -t 0.1 dummy; do :; done
}


enter_shell() {
    clear
    echo "==== Shell Mode ===="
    echo "Type 'exit' + Enter to go back to menu."
    echo
    /bin/ash -l
    while read -t 0.1 dummy; do :; done
}


main() {
    [ -t 0 ] && [ -t 1 ] || exit 0
    while :; do
        # 每次绘制菜单前清空stdin，彻底杜绝缓冲区残留
        while read -t 0.1 dummy; do :; done
        draw_menu
        read -r choice
        case "$choice" in
            1) set_lan_dhcp ;;
            2) set_lan_static ;;
            3) show_interfaces ;;
            4) show_processes ;;
            5) monitor_clients ;;
            6) enable_lan_dhcp ;;
            7) disable_lan_dhcp ;;
            q|Q) enter_shell ;;
            *) ;;
        esac
    done
}


main "$@"
