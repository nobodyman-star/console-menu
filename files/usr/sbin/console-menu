#!/bin/ash
# 自动识别工作模式（无brctl，仅使用内置ip工具）
detect_work_mode() {
    local has_nat=0
    local table_avail=0
    # 虚拟化标记检测，仅识别，不参与模式判定
    grep -Eiq 'vmware|virtualbox|kvm|qemu|hyper-v' /proc/cpuinfo 2>/dev/null
    # iptables 检测
    if command -v iptables >/dev/null 2>&1; then
        if iptables -t nat -nL POSTROUTING 2>/dev/null; then
            table_avail=1
            if iptables -t nat -nL POSTROUTING 2>/dev/null | grep -q MASQUERADE; then
                has_nat=1
            fi
        fi
    # nftables 检测
    elif command -v nft >/dev/null 2>&1; then
        if nft list table nat 2>/dev/null; then
            table_avail=1
            if nft list table nat 2>/dev/null | grep -q masquerade; then
                has_nat=1
            fi
        fi
    fi
    if [ "$table_avail" -eq 0 ]; then
        echo "Unknown"
    elif [ "$has_nat" -eq 1 ]; then
        echo "NAT Mode"
    else
        echo "Bypass Mode"
    fi
}

# 获取LAN DHCP(dnsmasq)服务状态
get_lan_dhcp_status() {
    local ignore
    ignore=$(uci -q get dhcp.lan.ignore 2>/dev/null)
    if [ "$ignore" = "1" ]; then
        echo "Disabled"
    else
        echo "Enabled"
    fi
}

# 开启LAN DHCP服务
enable_lan_dhcp() {
    echo "${C_CYAN}Enabling LAN DHCP service...${C_RESET}"
    uci -q delete dhcp.lan.ignore
    uci commit dhcp || { echo "${C_RED}UCI commit failed.${C_RESET}"; pause; return; }
    /etc/init.d/dnsmasq restart
    echo "${C_GREEN}LAN DHCP service is enabled.${C_RESET}"
    pause
}

# 关闭LAN DHCP服务
disable_lan_dhcp() {
    echo "${C_YELLOW}Disabling LAN DHCP service...${C_RESET}"
    uci set dhcp.lan.ignore='1'
    uci commit dhcp || { echo "${C_RED}UCI commit failed.${C_RESET}"; pause; return; }
    /etc/init.d/dnsmasq restart
    echo "${C_YELLOW}LAN DHCP service is disabled.${C_RESET}"
    pause
}

REFRESH_DELAY=1
# ANSI colors 扩充灰色，语义化
C_RESET='\033[0m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_CYAN='\033[1;36m'
C_RED='\033[1;31m'
C_WHITE='\033[1;37m'
C_GRAY='\033[1;90m'

pause() {
    printf "\n${C_CYAN}Press Enter to return...${C_RESET}"
    read -r _
}

valid_ipv4() {
    echo "$1" | awk -F. '
    NF==4 && $1<=255 && $2<=255 && $3<=255 && $4<=255
    {exit 0}
    {exit 1}
    '
}

get_lan_proto() {
    uci -q get network.lan.proto 2>/dev/null || echo "unknown"
}

get_cpu_usage() {
    # 读取第一次采样
    read _ u1 n1 s1 idle1 iw1 irq1 sirq1 rest1 < /proc/stat
    old_total=$((u1+n1+s1+idle1+iw1+irq1+sirq1))
    old_idle=$idle1
    sleep "$REFRESH_DELAY"
    # 读取第二次采样
    read _ u2 n2 s2 idle2 iw2 irq2 sirq2 rest2 < /proc/stat
    new_total=$((u2+n2+s2+idle2+iw2+irq2+sirq2))
    new_idle=$idle2
    diff_total=$((new_total - old_total))
    diff_idle=$((new_idle - old_idle))
    if [ "$diff_total" -gt 0 ]; then
        echo $(( 100 * (diff_total - diff_idle) / diff_total ))
    else
        echo 0
    fi
}

get_memory() {
    awk '
    /^MemTotal:/ { total=$2 }
    /^MemAvailable:/ { avail=$2 }
    END {
        used = total - avail
        printf "%dMB/%dMB (%d%%)", used/1024, total/1024, used*100/total
    }' /proc/meminfo
}

get_sessions() {
    if [ -r /proc/sys/net/netfilter/nf_conntrack_count ]; then
        cat /proc/sys/net/netfilter/nf_conntrack_count
    else
        echo "N/A"
    fi
}

get_client_count() {
    {
        [ -r /tmp/dhcp.leases ] && awk '{print $3}' /tmp/dhcp.leases
        ip neigh show 2>/dev/null | awk '$1 ~ /^[0-9]+\./ && $3!="FAILED" {print $1}'
    } | sort -u | wc -l
}

get_ip_addresses() {
    ip -o -4 addr show 2>/dev/null | awk '
    $2 != "lo" {
        sub(/\/.*/,"",$4)
        printf "    ├─ %s: \033[1;32m%s\033[0m\n", $2, $4
    }'
}

# 根据CPU数值返回对应颜色
color_cpu() {
    local cpu_val="$1"
    if [ "$cpu_val" -ge 80 ]; then
        echo "${C_RED}${cpu_val}%${C_RESET}"
    elif [ "$cpu_val" -ge 50 ]; then
        echo "${C_YELLOW}${cpu_val}%${C_RESET}"
    else
        echo "${C_GREEN}${cpu_val}%${C_RESET}"
    fi
}

# 工作模式颜色
color_workmode() {
    local mode="$1"
    case "$mode" in
        "NAT Mode") echo "${C_GREEN}${mode}${C_RESET}" ;;
        "Bypass Mode") echo "${C_YELLOW}${mode}${C_RESET}" ;;
        *) echo "${C_GRAY}${mode}${C_RESET}" ;;
    esac
}

# DHCP状态颜色
color_dhcp() {
    local st="$1"
    if [ "$st" = "Enabled" ]; then
        echo "${C_GREEN}${st}${C_RESET}"
    else
        echo "${C_YELLOW}${st}${C_RESET}"
    fi
}

draw_menu() {
    clear
    WORK_MODE=$(detect_work_mode)
    cpu_raw="$(get_cpu_usage)"
    cpu_colored=$(color_cpu "$cpu_raw")
    mem="$(get_memory)"
    sessions="$(get_sessions)"
    clients="$(get_client_count)"
    hostname="$(uci -q get system.@system[0].hostname 2>/dev/null || hostname)"
    lanproto="$(get_lan_proto)"
    lan_dhcp_status="$(get_lan_dhcp_status)"

    printf "${C_WHITE}Hostname: ${C_GREEN}%s${C_RESET}\n" "$hostname"
    printf "${C_WHITE}Cpu Usage: %s\n" "$cpu_colored"
    printf "${C_WHITE}Memory Usage: ${C_GREEN}%s${C_RESET}\n" "$mem"
    printf "${C_WHITE}Network Sessions: ${C_GREEN}%s${C_RESET}\n" "$sessions"
    printf "${C_WHITE}Client Num: ${C_GREEN}%s${C_RESET}\n" "$clients"
    printf "${C_WHITE}Work Mode: %s\n" "$(color_workmode "$WORK_MODE")"
    printf "${C_WHITE}LAN Protocol: ${C_GREEN}%s${C_RESET}\n" "$lanproto"
    printf "${C_WHITE}LAN DHCP Service: %s\n" "$(color_dhcp "$lan_dhcp_status")"
    printf "${C_WHITE}IP Addresses:${C_RESET}\n"
    get_ip_addresses

    printf "\n${C_CYAN}------------------------ Quick Start ------------------------${C_RESET}\n"
    printf "${C_YELLOW}[1]${C_WHITE} Set LAN(br-lan) IP Proto to DHCP ${C_RED}(RISK)${C_RESET}\n"
    printf "${C_GREEN}[2]${C_WHITE} Set LAN(br-lan) Static IP${C_RESET}\n"
    printf "${C_CYAN}[3]${C_WHITE} Show network interfaces (ip addr)${C_RESET}\n"
    printf "${C_CYAN}[4]${C_WHITE} Show Program Info (ps)${C_RESET}\n"
    printf "${C_CYAN}[5]${C_WHITE} Monitor Online Clients${C_RESET}\n"
    printf "${C_GREEN}[6]${C_WHITE} Enable LAN DHCP Service${C_RESET}\n"
    printf "${C_YELLOW}[7]${C_WHITE} Disable LAN DHCP Service${C_RESET}\n"
    printf "${C_RED}[q]${C_WHITE} Enter Shell ${C_RED}(DANGER)${C_RESET}\n"
    printf "${C_CYAN}-------------------------------------------------------------${C_RESET}\n"
    printf "${C_WHITE}Select an option: ${C_RESET}"
}

set_lan_dhcp() {
    echo "${C_RED}WARNING: Changing LAN to DHCP CLIENT, risk of losing LAN access!${C_RESET}"
    echo "${C_CYAN}Changing LAN protocol to DHCP...${C_RESET}"
    uci set network.lan.proto='dhcp' || return 1
    uci -q delete network.lan.ipaddr
    uci -q delete network.lan.netmask
    uci -q delete network.lan.gateway
    uci -q delete network.lan.broadcast
    uci commit network || { echo "${C_RED}UCI commit failed.${C_RESET}"; return 1; }
    /etc/init.d/network restart
    echo "${C_GREEN}LAN set to DHCP.${C_RESET}"
    pause
}

set_lan_static() {
    printf "${C_CYAN}Static IPv4 address (e.g. 192.168.1.1): ${C_RESET}"
    read -r ipaddr
    if ! valid_ipv4 "$ipaddr"; then
        echo "${C_RED}Invalid IPv4 address.${C_RESET}"
        pause
        return
    fi
    printf "${C_CYAN}Netmask [255.255.255.0]: ${C_RESET}"
    read -r netmask
    [ -z "$netmask" ] && netmask="255.255.255.0"
    if ! valid_ipv4 "$netmask"; then
        echo "${C_RED}Invalid netmask.${C_RESET}"
        pause
        return
    fi
    printf "${C_CYAN}Gateway (optional, press Enter skip): ${C_RESET}"
    read -r gateway
    uci set network.lan.proto='static'
    uci set network.lan.ipaddr="$ipaddr"
    uci set network.lan.netmask="$netmask"
    if [ -n "$gateway" ]; then
        if valid_ipv4 "$gateway"; then
            uci set network.lan.gateway="$gateway"
        else
            echo "${C_YELLOW}Gateway invalid, skip gateway${C_RESET}"
        fi
    else
        uci -q delete network.lan.gateway
    fi
    uci commit network || { echo "${C_RED}UCI commit failed.${C_RESET}"; pause; return; }
    echo "${C_CYAN}Applying network...${C_RESET}"
    /etc/init.d/network restart
    echo "${C_GREEN}Static IP applied: $ipaddr / $netmask${C_RESET}"
    pause
}

show_interfaces() {
    clear
    echo "${C_CYAN}Network interfaces${C_RESET}"
    echo "------------------"
    ip addr show 2>/dev/null
    echo
    echo "${C_CYAN}Routes:${C_RESET}"
    ip route show 2>/dev/null
    pause
}

show_processes() {
    clear
    echo "${C_CYAN}Running processes${C_RESET}"
    echo "-----------------"
    ps w
    pause
}

monitor_clients() {
    while :; do
        clear
        echo "${C_CYAN}Online clients (DHCP leases + ARP)${C_RESET}"
        echo "---------------------------------"
        printf "%-18s %-18s %-24s\n" "IPv4" "MAC" "Source"
        [ -r /tmp/dhcp.leases ] && awk '{printf "\033[1;32m%-18s %-18s DHCP Lease\033[0m\n",$3,$2}' /tmp/dhcp.leases
        ip neigh show 2>/dev/null | awk '$1 ~ /^[0-9]+\./ && $3!="FAILED" {printf "\033[1;36m%-18s %-18s ARP\033[0m\n",$1,$2}'
        echo
        echo "${C_YELLOW}Press q + Enter to exit monitor${C_RESET}"
        read -r answer
        [ "$answer" = "q" ] && break
    done
    # 退出监控循环前，清空stdin残留缓冲，解决需要按两次q的BUG
    while read -t 0.1 dummy; do :; done
}

enter_shell() {
    clear
    echo "${C_RED}==== Shell Mode ====${C_RESET}"
    echo "${C_CYAN}Type 'exit' + Enter to go back to menu.${C_RESET}"
    echo
    /bin/ash -l
    while read -t 0.1 dummy; do :; done
}

main() {
    [ -t 0 ] && [ -t 1 ] || exit 0
    while :; do
        # 每次绘制菜单前清空stdin，彻底杜绝缓冲区残留
        while read -t 0.1 dummy; do :; done
        draw_menu
        read -r choice
        case "$choice" in
            1) set_lan_dhcp ;;
            2) set_lan_static ;;
            3) show_interfaces ;;
            4) show_processes ;;
            5) monitor_clients ;;
            6) enable_lan_dhcp ;;
            7) disable_lan_dhcp ;;
            q|Q) enter_shell ;;
            *) ;;
        esac
    done
}

main "$@"
